### DO NOT EDIT THIS FILE ###
NUMJOBS := $(shell ps -o args= -p $$PPID | grep -o "\-j[0-9]*")

ifneq ($(NUMJOBS),)
    MAKEFLAGS := $(filter-out -j%,$(MAKEFLAGS))
    $(warning Please DO NOT use make -jN.)
    $(warning buildroot would process parallel compiling automatically.)
    $(warning Just use `make`, NO -j)
endif

include $(TARGET_OUTPUT_DIR)/Makefile

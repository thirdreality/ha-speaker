From: Buildroot <buildroot@buildroot.org>
Date: Thu, 28 Nov 2024 10:00:00 +0000
Subject: [PATCH] Exclude Windows-specific files for Linux ARM builds

Exclude Windows-specific source files (*_win.cc) from compilation
when building for Linux ARM platforms.

Signed-off-by: Buildroot <buildroot@buildroot.org>
---
 setup.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/setup.py b/setup.py
index 1234567..abcdefg 100644
--- a/setup.py
+++ b/setup.py
@@ -47,7 +47,7 @@ def get_yocto_var(var_name):
 def process_arch(arch, set_compile_flags=False):
     global ap_sources, define_macros
     if arch.find('arm') >= 0:
-        ap_sources = [src for src in ap_sources if src.find('mips.') < 0 and src.find('sse') < 0]
+        ap_sources = [src for src in ap_sources if src.find('mips.') < 0 and src.find('sse') < 0 and src.find('_win.') < 0]
         define_macros.append(('WEBRTC_HAS_NEON', None))
         if arch.find('arm64') >= 0:
             define_macros.remove(('WEBRTC_LINUX', None))
@@ -60,7 +60,7 @@ def process_arch(arch, set_compile_flags=False):
                 extra_compile_args.append('-mfloat-abi=hard')
                 extra_compile_args.append('-mfpu=neon')
     elif arch.find('aarch64') >= 0:
-        ap_sources = [src for src in ap_sources if src.find('mips.') < 0 and src.find('sse') < 0]
+        ap_sources = [src for src in ap_sources if src.find('mips.') < 0 and src.find('sse') < 0 and src.find('_win.') < 0]
         define_macros.append(('WEBRTC_HAS_NEON', None))
         define_macros.append(('WEBRTC_ARCH_ARM64', None))
     elif arch.find('x86') >= 0:
-- 
2.34.1
config BR2_PACKAGE_LINUX_VOICE_ASSISTANT_CPP
	bool "linux-voice-assistant-cpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_PROTOBUF_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # protobuf C++11 + json-for-modern-cpp
	depends on !BR2_STATIC_LIBS              # protobuf is shared-only
	select BR2_PACKAGE_PROTOBUF
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	select BR2_PACKAGE_MPV
	select BR2_PACKAGE_PULSEAUDIO  # default audio output for libmpv
	select BR2_PACKAGE_WEBRTC_AUDIO_PROCESSING  # AGC + NS for the mic
	default n
	help
	  C++ rewrite of the linux-voice-assistant package.
	  Replaces the Python implementation with a single native
	  binary that speaks the ESPHome API to Home Assistant,
	  runs MicroWakeWord inference natively, and integrates
	  ThirdReality LED ring, mute GPIO, sound.json bridge,
	  Home button events, OTA, and the supervisor HTTP API.

	  Requires a C++20-capable toolchain (gcc >= 10).

	  This package is intended to fully replace
	  BR2_PACKAGE_LINUX_VOICE_ASSISTANT once on-device
	  verified. Do NOT enable both at the same time.

	  See: doc/linux-voice-assistant-cpp-refactor-plan.md

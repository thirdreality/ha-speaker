#! /bin/sh
# SPDX-License-Identifier: GPL-3.0
# code url: https://github.com/badaix/snapos

NAME=snapclient
DAEMON=/usr/bin/$NAME
PIDDIR=/var/run/thirdreality
MONITOR_PIDFILE=$PIDDIR/music-assistant.pid
RESTART_DELAY=5

[ -r /etc/default/$NAME ] && . /etc/default/$NAME
SNAPCLIENT_OPTS="-d $SNAPCLIENT_OPTS"

if [ "$START_SNAPCLIENT" != "true" ] ; then
  exit 0
fi

is_pid_running() {
	pidfile="$1"
	[ -f "$pidfile" ] || return 1

	pid="$(cat "$pidfile" 2>/dev/null)"
	[ -n "$pid" ] || return 1

	kill -0 "$pid" 2>/dev/null
}

is_snapclient_running() {
	pidof "$NAME" >/dev/null 2>&1
}

start_snapclient() {
	if is_snapclient_running; then
		return 0
	fi

	echo -n "Starting $NAME: "
	start-stop-daemon --start --quiet --name "$NAME" --exec "$DAEMON" -- $SNAPCLIENT_OPTS
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop_snapclient() {
	echo -n "Stopping $NAME: "
	start-stop-daemon --stop --quiet --retry=TERM/30/KILL/5 --name $NAME
	RETVAL="$?"
	[ "$RETVAL" = 2 ] && return 2
	start-stop-daemon --stop --quiet --oknodo --retry=0/30/KILL/5 --exec $DAEMON
	[ "$?" = 2 ] && return 2
	return "$RETVAL"
}

monitor_snapclient() {
	while true; do
		if ! is_snapclient_running; then
			start_snapclient
		fi
		sleep "$RESTART_DELAY"
	done
}

start() {
	mkdir -p "$PIDDIR"

	if is_pid_running "$MONITOR_PIDFILE"; then
		return 0
	fi

	rm -f "$MONITOR_PIDFILE"
	monitor_snapclient &
	echo $! > "$MONITOR_PIDFILE"
}

stop() {
	if is_pid_running "$MONITOR_PIDFILE"; then
		kill "$(cat "$MONITOR_PIDFILE")" 2>/dev/null
	fi
	rm -f "$MONITOR_PIDFILE"

	stop_snapclient
}

restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

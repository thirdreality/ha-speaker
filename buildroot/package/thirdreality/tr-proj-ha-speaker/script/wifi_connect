#!/bin/sh

DEVICE_INFO="/data/conf/device.json"
DEVICE_INFO_TMP="/tmp/device_info.wifi.tmp.json"
DEVICE_INFO_LOCK="/tmp/device_info.lock"

switch_wifi=0

get_scan_flags()
{
    local ssid="$1"

    wpa_cli -i wlan0 scan_results | awk -F '\t' -v target_ssid="$ssid" '
        NR > 1 && $5 == target_ssid {
            print $4
            exit
        }
    '
}

scan_result_exists()
{
    local ssid="$1"

    wpa_cli -i wlan0 scan_results | awk -F '\t' -v target_ssid="$ssid" '
        NR > 1 && $5 == target_ssid {
            found = 1
            exit
        }
        END {
            exit(found ? 0 : 1)
        }
    '
}

get_network_id_by_ssid()
{
    local ssid="$1"

    wpa_cli -i wlan0 list_networks | awk -F '\t' -v target_ssid="$ssid" '
        NR > 1 && $2 == target_ssid {
            print $1
            exit
        }
    '
}

get_valid_ipv4_address()
{
    ip -o -4 addr show dev wlan0 scope global 2>/dev/null | awk '{print $4}' | cut -d'/' -f1 | head -1
}

get_link_local_ipv4_address()
{
    ip -o -4 addr show dev wlan0 scope link 2>/dev/null | awk '{print $4}' | cut -d'/' -f1 | head -1
}

update_network_info()
{
    local status="$1"
    local ssid="$2"
    local ip="$3"

    (
        flock -x 9
        jq --arg status "$status" --arg ssid "$ssid" --arg ip "$ip" '
            .network.status = $status
            | .network.ssid = $ssid
            | .network.ip = $ip
        ' "$DEVICE_INFO" > "$DEVICE_INFO_TMP" && mv "$DEVICE_INFO_TMP" "$DEVICE_INFO"
    ) 9>"$DEVICE_INFO_LOCK"
}

clean_config()
{
    local current_ssid=$(wpa_cli -i wlan0 status | awk -F= '/^ssid=/ {print $2}')
    local current_id=$(wpa_cli -i wlan0 list_networks | grep '\[CURRENT\]' | awk '{print $1}')
    
    # 如果没有找到当前网络，不执行清理
    # if [ -z "$current_id" ]; then
    #     echo "Warning: No current network found, skipping cleanup"
    #     return 0
    # fi
    
    echo "Cleaning networks (keeping ID $current_id: $current_ssid)"
    
    wpa_cli -i wlan0 list_networks | tail -n +2 | awk '{print $1}' | while read -r id; do
        [ -n "$id" ] && [ "$id" != "$current_id" ] && {
            echo "Removing network $id"
            wpa_cli -i wlan0 remove_network "$id" > /dev/null
        }
    done

    wpa_cli -i wlan0 save_config > /dev/null
}

detect_wifi_type()
{
    local ssid="$1"
    local flags=""

    flags=$(get_scan_flags "$ssid")

    if [ -z "$flags" ]; then
        echo "unknown"
        return
    fi

    case "$flags" in
        *WPA3-SAE*WPA2-PSK*)
            echo "wpa2-wpa3-mixed"
            ;;
        *WPA2-PSK*WPA-PSK*|*WPA-PSK*WPA2-PSK*)
            echo "wpa-wpa2-mixed"
            ;;
        *WPA2-PSK*)
            echo "wpa2-psk"
            ;;
        *WPA-PSK*)
            echo "wpa-psk"
            ;;
        *WEP*)
            echo "wep"
            ;;
        *ESS*)
            echo "open"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

wifi_connect()
{
    local ssid="$1"
    local psk="$2"
    local hidden="$3"

    echo "Connecting to SSID: $ssid"

    local type
    if [ "$hidden" = "1" ]; then
        # Hidden APs do not appear in passive scan results, so flags
        # cannot be read. Assume WPA2-PSK when a passphrase is given,
        # otherwise an open network — matches the existing fallback
        # in the "unknown" branch below.
        if [ -z "$psk" ]; then
            type="open"
        else
            type="wpa2-psk"
        fi
        echo "Hidden SSID: assuming WiFi type: $type"
    else
        type=$(detect_wifi_type "$ssid")
        echo "Detected WiFi type: $type"
    fi

    id=$(wpa_cli -i wlan0 add_network)
    wpa_cli -i wlan0 set_network "$id" ssid "\"$ssid\""

    # Always enable directed-probe scanning for saved networks. This
    # serves two purposes:
    #   1. Associates with APs that don't broadcast their SSID at
    #      provisioning time (the $hidden=1 path above).
    #   2. Keeps the connection working if the user later flips the
    #      AP to "hide SSID" — without scan_ssid, wpa_supplicant
    #      would only do passive scans on reconnect and never see
    #      the network again.
    # Tradeoff: one extra directed probe request per scan cycle.
    # Negligible vs. the alternative of silent reconnect failure.
    # This matches how Android / NetworkManager / iOS treat saved
    # networks by default.
    wpa_cli -i wlan0 set_network "$id" scan_ssid 1

    case "$type" in
        open)
            wpa_cli -i wlan0 set_network "$id" key_mgmt NONE
            ;;
        wep)
            wpa_cli -i wlan0 set_network "$id" key_mgmt NONE
            wpa_cli -i wlan0 set_network "$id" wep_key0 "\"$psk\""
            wpa_cli -i wlan0 set_network "$id" wep_tx_keyidx 0
            ;;
        wpa2-wpa3-mixed)
            wpa_cli -i wlan0 set_network "$id" psk "\"$psk\""
            wpa_cli -i wlan0 set_network "$id" key_mgmt "WPA-PSK SAE"
            wpa_cli -i wlan0 set_network "$id" ieee80211w 0
            # wpa_cli -i wlan0 set_network "$id" ieee80211w 1
            ;;
        wpa-wpa2-mixed)
            wpa_cli -i wlan0 set_network "$id" psk "\"$psk\""
            wpa_cli -i wlan0 set_network "$id" key_mgmt WPA-PSK
            ;;
        wpa2-psk)
            wpa_cli -i wlan0 set_network "$id" psk "\"$psk\""
            wpa_cli -i wlan0 set_network "$id" key_mgmt WPA-PSK
            ;;
        wpa-psk)
            wpa_cli -i wlan0 set_network "$id" psk "\"$psk\""
            wpa_cli -i wlan0 set_network "$id" key_mgmt WPA-PSK
            ;;
        *)
            if [ -z "$psk" ]; then
                wpa_cli -i wlan0 set_network "$id" key_mgmt NONE
            else
                wpa_cli -i wlan0 set_network "$id" psk "\"$psk\""
                wpa_cli -i wlan0 set_network "$id" key_mgmt WPA-PSK
            fi
            ;;
    esac

    wpa_cli -i wlan0 enable_network "$id"
    wpa_cli -i wlan0 save_config
    wpa_cli -i wlan0 select_network "$id"
}

wifi_disconnect()
{
    local ssid=$(wpa_cli -i wlan0 status | grep -E '^ssid=' | awk -F "=" '{print $2}')
    local network_id=$(get_network_id_by_ssid "$ssid")

    echo "Disconnect ${ssid}"
    echo "$network_id" > /tmp/old_wifi_id
    echo "$ssid" > /tmp/old_wifi_ssid

    wpa_cli -i wlan0 disconnect
}

wifi_reconnect()
{
    echo "Attempting to reconnect to previous WiFi..."
    
    local old_id=""
    local old_ssid=""
    
    if [ -f /tmp/old_wifi_id ]; then
        old_id=$(cat /tmp/old_wifi_id)
        old_ssid=$(cat /tmp/old_wifi_ssid 2>/dev/null)
    fi
    
    if [ -z "$old_id" ]; then
        echo "ERROR: No previous network ID found"
        return 1
    fi
    
    echo "Reconnecting to previous network: $old_ssid (ID: $old_id)"
    
    if ! wpa_cli -i wlan0 list_networks | tail -n +2 | awk '{print $1}' | grep -q "^${old_id}$"; then
        echo "ERROR: Previous network configuration (ID: $old_id) not found"
        rm -f /tmp/old_wifi_id /tmp/old_wifi_ssid
        return 1
    fi

    wpa_cli -i wlan0 enable_network "$old_id" > /dev/null
    wpa_cli -i wlan0 select_network "$old_id" > /dev/null
    wpa_cli -i wlan0 save_config > /dev/null

    local cnt=0
    local connected=0
    
    while [ $cnt -lt 10 ]; do
        echo "Reconnecting... ($((cnt + 1))/10)"
        rc=$(wpa_cli -i wlan0 status | grep 'wpa_state=' | cut -d'=' -f2)
        
        if [ "$rc" = "COMPLETED" ]; then
            connected=1
            echo "Successfully reconnected to: $old_ssid"
            break
        fi
        
        cnt=$((cnt + 1))
        sleep 1
    done
    
    rm -f /tmp/old_wifi_id /tmp/old_wifi_ssid
    
    if [ $connected -eq 1 ]; then
        wifi_connect_success
    else
        echo "ERROR: Failed to reconnect to previous WiFi"
        clean_config
        return 1
    fi
}

restart_dhcp_client()
{
    echo "Restarting DHCP client on wlan0..."
    /etc/init.d/S41dhcpcd restart
}

wifi_connect_success()
{
    local ssid=$(wpa_cli status | awk -F= '/^ssid/ {print $2}')
    local ip=""
    local link_local_ip=""
    local max_retries=15
    local retry_count=0

    restart_dhcp_client

    while [ $retry_count -lt $max_retries ]; do
        ip=$(get_valid_ipv4_address)

        if [ -n "$ip" ]; then
            echo "Valid IP address obtained: $ip"
            break
        else
            link_local_ip=$(get_link_local_ipv4_address)
            if [ -n "$link_local_ip" ]; then
                echo "Link-local address: $link_local_ip, waiting for DHCP... ($((retry_count + 1))/$max_retries)"
            else
                echo "No IP address yet, waiting... ($((retry_count + 1))/$max_retries)"
            fi
        fi

        retry_count=$((retry_count + 1))
        sleep 1
    done

    if [ -z "$ip" ]; then
        echo "ERROR: Failed to obtain IP address after $max_retries attempts"
        update_network_info "disconnected" "" ""
        clean_config
        sync
        exit 12
    fi

    echo "Connection successful - SSID: $ssid, IP: $ip"

    update_network_info "connected" "$ssid" "$ip"

    clean_config
    sync
    exit 0
}

wifi_connect_failed()
{
    if [ $switch_wifi -eq 1 ]; then
        switch_wifi=0
        wifi_reconnect
        update_network_info "disconnected" "" ""
        sync
        exit 14
    else
        update_network_info "disconnected" "" ""
        clean_config
        sync
        exit 13
    fi
}

wifi()
{
    local ssid=$1
    local psk=$2
    local connected=0
    local hidden=0

    wpa_cli scan > /dev/null
    sleep 2
    if ! scan_result_exists "$ssid"; then
        # SSID not in scan results. Could be:
        #   - a hidden AP (no SSID broadcast in beacons)
        #   - a 5 GHz-only AP (this device is 2.4 GHz only)
        #   - a wrong SSID
        # Assume hidden and let wpa_supplicant try a directed probe.
        # If the AP genuinely doesn't exist, the connect loop below
        # will time out and return 13.
        echo "SSID '$ssid' not in scan results, assuming hidden network"
        hidden=1
    fi

    if wpa_cli -i wlan0 status | grep -iq completed; then
        switch_wifi=1
        wifi_disconnect
        sleep 1
    fi

    wifi_connect "$ssid" "$psk" "$hidden"

    local cnt=0
    while [ $cnt -lt 10 ]
    do
        echo "Connecting to ${ssid}..."
        rc=$(wpa_cli status | grep 'wpa_state=' | cut -d'=' -f2)
        echo "Status: $rc"
        if [ "$rc" = "COMPLETED" ]; then
            connected=1
            echo "Connect ${ssid} successfully!"
            break
        fi
        cnt=$((cnt + 1))
        sleep 1
    done

    if [ $connected -eq 1 ]; then
        wifi_connect_success
    else
        wifi_connect_failed
    fi
}

case "$1" in
    connect)
        wifi "$2" "$3"
        ;;
    *)
        echo "Usage: $0 {connect ssid psk}"
        exit 1
esac

# return codes:
# 0 - success
# 10 - (deprecated) ssid not found in scan results; the script now
#      treats this case as a possibly-hidden SSID and falls through
#      to the normal connect path
# 11 - wpa cli command failed to execute
# 12 - failed to get valid ip address
# 13 - failed to connect to the ssid
# 14 - failed to switch wifi

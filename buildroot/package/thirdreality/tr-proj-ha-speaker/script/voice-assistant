#!/bin/sh

PIDDIR=/var/run/thirdreality
VOICE_ASSISTANT_PIDFILE=$PIDDIR/voice-assistant.pid
DEVICE_CONF="/data/conf/device.json"

start_voice_assistant_process() {
    if [ -f $VOICE_ASSISTANT_PIDFILE ]; then
        PID=$(cat $VOICE_ASSISTANT_PIDFILE)
        if kill -0 "$PID" 2>/dev/null; then
            return 0
        fi
        rm -f $VOICE_ASSISTANT_PIDFILE
    fi
    
    SPK_NAME=$(jq -r '.device.name // "thirdreality-speaker"' "$DEVICE_CONF")
    python3 -m linux_voice_assistant --name "$SPK_NAME" --wake-model "okay_nabu" --debug &
    echo $! > $VOICE_ASSISTANT_PIDFILE
}

start() {
    mkdir -p $PIDDIR

    start_voice_assistant_process
    
    while true; do
        if [ -f $VOICE_ASSISTANT_PIDFILE ]; then
            PID=$(cat $VOICE_ASSISTANT_PIDFILE)
            if ! kill -0 "$PID" 2>/dev/null; then
                rm -f $VOICE_ASSISTANT_PIDFILE
                start_voice_assistant_process
                sleep 5
            fi
        else
            start_voice_assistant_process
            sleep 5
        fi

        if [ -z "$(pidof pulseaudio)" ]; then
            sync
            sleep 3
            reboot -f
        fi

        sleep 10
    done
}

stop() {
    if [ -f $VOICE_ASSISTANT_PIDFILE ]; then
        PID=$(cat $VOICE_ASSISTANT_PIDFILE)
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            sleep 1
            kill -9 "$PID" 2>/dev/null
        fi
        rm -f $VOICE_ASSISTANT_PIDFILE
    fi
    
    echo "Voice assistant stopped"
}

case "$1" in
    start)
        start &
    ;;
    stop)
        stop
    ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
    ;;
esac

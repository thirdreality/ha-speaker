From 83f92be3d4e8313a0b4b592dd0d5a5d36502ed5d Mon Sep 17 00:00:00 2001
From: "tianwei.ge" <tianwei.ge@thirdreality.ai>
Date: Wed, 10 Jan 2024 11:42:46 +0800
Subject: [PATCH 1/2] add option for going to the recovery mode directly

---
 core/swupdate.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/core/swupdate.c b/core/swupdate.c
index d72dc6a..41d4673 100644
--- a/core/swupdate.c
+++ b/core/swupdate.c
@@ -157,6 +157,7 @@ static void usage(char *programname)
 		" -H, --hwrevision <board>:<rev> : Set hardware revision\n"
 #endif
 		" -c, --check                    : check image and exit, use with -i <filename>\n"
+		" -G, --go-to-recovery           : go to the recovery mode\n"
 		" -h, --help                     : print this help and exit\n"
 		);
 #ifdef CONFIG_DOWNLOAD
@@ -595,6 +596,7 @@ int main(int argc, char **argv)
 	int opt_i = 0;
 	int opt_e = 0;
 	int opt_c = 0;
+	int opt_G = 0;
 	char image_url[MAX_URL];
 	char main_options[256];
 	unsigned int public_key_mandatory = 0;
@@ -649,6 +651,7 @@ int main(int argc, char **argv)
 #ifdef CONFIG_ENCRYPTED_IMAGES
 	strcat(main_options, "K:");
 #endif
+	strcat(main_options, "G");
 
 	memset(fname, 0, sizeof(fname));
 
@@ -861,6 +864,9 @@ int main(int argc, char **argv)
 			strncpy(swcfg.globals.preupdatecmd, optarg,
 				sizeof(swcfg.globals.preupdatecmd));
 			break;
+		case 'G':
+			opt_G = 1;
+			break;
 		default:
 			usage(argv[0]);
 			exit(EXIT_FAILURE);
@@ -906,6 +912,23 @@ int main(int argc, char **argv)
 	}
 #endif
 
+	if (opt_G) {
+#ifdef CONFIG_MTD
+		printf("before mtd_cleanup\n");
+		mtd_cleanup();
+		// printf("before scan_mtd_devices\n");
+		// scan_mtd_devices();
+#endif
+		printf("before set_recovery\n");
+		set_recovery();
+		printf("after set_recovery\n");
+		system("reboot");
+		printf("swupdate, rebooting...\n");
+		sleep(5);
+
+		exit(0);
+	}
+
 	swupdate_crypto_init();
 
 	if (strlen(swcfg.globals.publickeyfname)) {
-- 
2.40.1


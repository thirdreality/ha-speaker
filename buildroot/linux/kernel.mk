## Various utility functions for linux kernel
##
################################################################################
################################################################################
define KCONFIG_ENABLE_OPT # (option, file)
	sed -i -e "/\\<$(1)\\>/d" $(2)
	echo '$(1)=y' >> $(2)
endef

define KCONFIG_SET_OPT # (option, value, file)
	sed -i -e "/\\<$(1)\\>/d" $(3)
	echo '$(1)=$(2)' >> $(3)
endef

define KCONFIG_DISABLE_OPT # (option, file)
	sed -i -e "/\\<$(1)\\>/d" $(2)
	echo '# $(1) is not set' >> $(2)
endef

define KCONFIG_DISABLE_OPT_LIST # (options, file)
	for kernel_item in $$(echo $(1)); 	do \
		sed -i -e "/\\<$$kernel_item\\>/d" $(2); \
		echo "# $$kernel_item is not set" >> $(2); \
	done
endef

define KCONFIG_ENABLE_OPT_LIST # (options, file)
	for kernel_item in $$(echo $(1)); 	do \
		sed -i -e "/\\<$$kernel_item\\>/d" $(2); \
		echo "$$kernel_item=y" >> $(2); \
	done
endef

define KCONFIG_SET_OPT_LIST # (options, file)
	for kernel_set in $$(echo $(1)); 	do \
		kernel_item=$$(echo $$kernel_set| cut -d'=' -f1); \
		sed -i -e "/\\<$$kernel_item\\>/d" $(2); \
		echo "$$kernel_set" >> $(2); \
	done
endef

define KCONFIG_SET_TRISTATE_OPT # (option, value[m,y,n], file)
	$(if $(filter $(2), n),$(call KCONFIG_DISABLE_OPT,$(1),$(3)),$(call KCONFIG_SET_OPT,$(1),$(2),$(3)))
endef

define KCONFIG_SET_BOOL_OPT # (option, value[m,y,n], file)
	$(if $(filter $(2), m),$(call KCONFIG_SET_TRISTATE_OPT,$(1),y,$(3)),
			$(call KCONFIG_SET_TRISTATE_OPT,$(1),$(2),$(3)))
endef

CUSTOMIZE_KERNEL_ENABLE_OPT_LIST="CONFIG_FUSE_FS CONFIG_NFS_FS CONFIG_NFS_V2 CONFIG_NFS_V3 CONFIG_NFS_V4 CONFIG_NFS_COMMON"
CUSTOMIZE_KERNEL_DISABLE_OPT_LIST=""
ifneq ($(filter C302X_N2 C302X_N3 C308L C308L_N2N3, $(BR2_AML_C3_PLATFORM)),)
CUSTOMIZE_KERNEL_SET_OPT_LIST=""
else ifneq ($(filter C302X_N2_DoorBell C302X_N3_DoorBell, $(BR2_AML_C3_PLATFORM)),)
CUSTOMIZE_KERNEL_SET_OPT_LIST="CONFIG_FUSE_FS=n CONFIG_NTFS_FS=n CONFIG_OVERLAY_FS=n"
else ifeq ($(BR2_AML_C3_PLATFORM), C302X_EMMC)
CUSTOMIZE_KERNEL_SET_OPT_LIST="CONFIG_AMLOGIC_NAND=n"
endif

define AML_KERNEL_GENERAL_CONFIGURATION # (file)
	$(call AML_KERENL_MODULE_ALWAYS_BUILD_IN,$(1))

	$(if $(filter $(BR2_AML_C3_PLATFORM), C302X_N2_DoorBell C302X_N3_DoorBell),$(call AML_KERNEL_MODULE_CONFIG_SET_OPT,m,$(1)),
		$(if $(filter $(BR2_AML_C3_ROOTFS_MEDIUM), FLASH),$(call AML_KERENL_MODULE_BUILD_IN,$(1)) 	$(call AML_KERNEL_MODULE_CONFIG_SET_OPT,y,$(1)),
		$(call AML_KERNEL_MODULE_CONFIG_SET_OPT,m,$(1))))

	$(call AML_FS_CONFIG_SET_OPT,y,$(1))
	$(if $(filter $(BR2_AML_C3_TEE_SUPPORT), y),$(call KCONFIG_ENABLE_OPT,CONFIG_AMLOGIC_AMLTEE,$(1)) $(call KCONFIG_ENABLE_OPT,CONFIG_AMLOGIC_TEE,$(1)) $(call KCONFIG_ENABLE_OPT,CONFIG_AMLOGIC_OPTEE,$(1)))

	$(call KCONFIG_DISABLE_OPT_LIST,$(CUSTOMIZE_KERNEL_DISABLE_OPT_LIST),$(1))
	$(call KCONFIG_ENABLE_OPT_LIST,$(CUSTOMIZE_KERNEL_ENABLE_OPT_LIST),$(1))
	$(call KCONFIG_SET_OPT_LIST,$(CUSTOMIZE_KERNEL_SET_OPT_LIST),$(1))
endef


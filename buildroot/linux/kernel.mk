	$(call KCONFIG_SET_TRISTATE_OPT,CONFIG_BT_HCIUART,$(1),$(2))
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_BT_HCIUART_SERDEV,$(1),$(2))
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_BT_HCIUART_H4,$(1),$(2))
	$(call KCONFIG_SET_TRISTATE_OPT,CONFIG_BT,$(1),$(2))
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_BT_BREDR,$(1),$(2))
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_BT_LE,$(1),$(2))
endef

### DM-VERITY ###
define AML_DM_VERITY_KCONFIG_SET_OPT # (value[m,y,n], file)
# dm verity
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_MD,$(1),$(2))
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_BLK_DEV_DM,$(1),$(2))
	$(call KCONFIG_SET_BOOL_OPT,CONFIG_DM_VERITY,$(1),$(2))
	$(call KCONFIG_SET_TRISTATE_OPT,CONFIG_CRYPTO_SHA1,y,$(2))
	$(call KCONFIG_SET_TRISTATE_OPT,CONFIG_CRYPTO_SHA256,y,$(2))
endef


define AML_KERNEL_MODULE_CONFIG_SET_OPT # (value[m,y], file)
	$(if $(filter $(BR2_AML_C3_PLATFORM), C308L),,$(call AML_CRYPTO_KCONFIG_SET_OPT,n,$(2)))
	$(if $(findstring NON, $(BR2_AML_C3_SECURITY_BOOT)),$(call AML_DM_VERITY_KCONFIG_SET_OPT,n,$(2)),$(call AML_DM_VERITY_KCONFIG_SET_OPT,$(1),$(2)))
	$(if $(filter $(BR2_AML_C3_ADB_SUPPORT), y),$(call AML_ADB_KCONFIG_SET_OPT,$(1),$(2)),$(call AML_ADB_KCONFIG_SET_OPT,n,$(2)))
	$(if $(filter $(BR2_AML_C3_USB_SUPPORT), y),$(call AML_USB_STORAGE_KCONFIG_SET_OPT,$(1),$(2)),$(call AML_USB_STORAGE_KCONFIG_SET_OPT,n,$(2)))
	$(if $(filter $(BR2_AML_C3_WIFI_SUPPORT), y),$(call AML_WIFI_KCONFIG_SET_OPT,$(1),$(2)),$(call AML_WIFI_KCONFIG_SET_OPT,n,$(2)))
	$(if $(filter $(BR2_AML_C3_BT_SUPPORT), y),$(call AML_BLUETOOTH_KCONFIG_SET_OPT,$(1),$(2)),$(call AML_BLUETOOTH_KCONFIG_SET_OPT,n,$(2)))
	$(if $(filter $(BR2_PACKAGE_MBD_VPU), y),$(call AML_MEDIA_KCONFIG_SET_OPT,$(1),$(2)),
			$(call AML_MEDIA_KCONFIG_SET_OPT,n,$(2)) $(call AML_ASOC_KCONFIG_SET_OPT,n,$(2)))
	$(if $(filter $(BR2_AML_C3_BOOT_MEDIUM), SPI_NAND),$(call AML_SPI_NAND_FLASH_KCONFIG_SET_OPT,$(1),$(2)) $(call AML_SPI_NOR_FLASH_KCONFIG_SET_OPT,n,$(2)))
	$(if $(filter $(BR2_AML_C3_BOOT_MEDIUM), SPI_NOR),$(call AML_SPI_NOR_FLASH_KCONFIG_SET_OPT,$(1),$(2)) $(call AML_SPI_NAND_FLASH_KCONFIG_SET_OPT,n,$(2)))
endef

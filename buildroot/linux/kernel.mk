	$(if $(filter $(BR2_TARGET_ROOTFS_SQUASHFS), y),$(call AML_FS_SQUASHFS_KCONFIG_SET_OPT,$(1),$(2)),$(call AML_FS_SQUASHFS_KCONFIG_SET_OPT,n,$(2)))

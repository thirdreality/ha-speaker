ifeq ($(BR2_AML_C3_DTB_OVERLAY),y)
define AML_C3_LINUX_DTB_OVERLAY
        $(foreach overlay,$(1),\
                $(@D)/scripts/dtc/dtc -q -I dts -O dtb -o $(BINARIES_DIR)/$(overlay).dtbo $(AML_C3_ENV_SITE)/dtb_overlay/$(overlay).dtsi; \
                $(@D)/scripts/dtc/fdtoverlay -i $(2)/$(AML_DTBS) -o $(2)/$(AML_DTBS) $(BINARIES_DIR)/$(overlay).dtbo; \
        )
endef
endif